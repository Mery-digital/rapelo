{
  "expo": {
    "name": "RAPELO",
    "slug": "rapelo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.jpg",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EFF3F9",
    "splash": {
      "image": "./assets/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rapelo.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["whatsapp", "sms"],
        "NSCameraUsageDescription": "RAPELO utilise la caméra pour prendre la photo de l'appareil du client.",
        "NSPhotoLibraryUsageDescription": "RAPELO accède à tes photos pour choisir une photo de l'appareil."
      }
    },
    "android": {
      "package": "com.rapelo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.jpg",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logo.jpg",
      "name": "RAPELO",
      "shortName": "RAPELO",
      "themeColor": "#0F172A",
      "backgroundColor": "#F1F5F9"
    }
  }
}
